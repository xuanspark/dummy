# Copy to .env and edit. All variables prefixed with ROBOT_.
# The backend never auto-connects; these are just defaults pre-filled
# in the connect dialog and used by /api/connection/defaults.

# Default values for the connect dialog (optional, can be left blank)
ROBOT_DEFAULT_PORT=
ROBOT_DEFAULT_BAUD=115200

# HTTP / WS server bind
ROBOT_HTTP_HOST=0.0.0.0
ROBOT_HTTP_PORT=8000

# Default command timeout (seconds)
ROBOT_CMD_TIMEOUT=5.0
